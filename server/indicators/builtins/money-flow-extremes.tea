indicator("Money Flow Extremes", overlay = false)
length = input.int(14, "Length", minval = 2, maxval = 500)
value = ta.mfi(hlc3, length)
plot("flow", value, "Money Flow Index", color=#81BBB5, linewidth=2)
top = hline("maximum", 100, "Maximum", color=color.new(#BFA0CF, 85))
u = hline("upper", 80, "Upper threshold", color=#BFA0CF, linestyle=hline.style_dashed)
l = hline("lower", 20, "Lower threshold", color=#7EBEB1, linestyle=hline.style_dashed)
bottom = hline("minimum", 0, "Minimum", color=color.new(#7EBEB1, 85))
fill("upper_zone", top, u, color=color.new(#BFA0CF, 85))
fill("lower_zone", l, bottom, color=color.new(#7EBEB1, 85))
plotshape("upper_exit", barstate.isconfirmed and ta.crossunder(value, 80), "MFI returned below 80", style=shape.triangledown, location=location.top, color=#BFA0CF, text="Leaves upper zone", textcolor=#BFA0CF, size=size.tiny)
plotshape("lower_exit", barstate.isconfirmed and ta.crossover(value, 20), "MFI returned above 20", style=shape.triangleup, location=location.bottom, color=#7EBEB1, text="Leaves lower zone", textcolor=#7EBEB1, size=size.tiny)
