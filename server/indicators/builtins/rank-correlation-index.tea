indicator("Rank Correlation Index", overlay = false)
// ponytail: O(length^2) ranks, capped at 100; use sorted ranks for larger windows.
source = input.source(close, "Source")
length = input.int(9, "Length", minval = 2, maxval = 100)
mean = (length + 1) / 2.0
covariance = 0.0
variance = 0.0
for i = 0 to length - 1
    rank = 1.0
    for j = 0 to length - 1
        rank += source[j] < source[i] ? 1 : j != i and source[j] == source[i] ? 0.5 : 0
    covariance += (rank - mean) * (length - i - mean)
    variance += math.pow(rank - mean, 2)
timeVariance = length * (length * length - 1) / 12.0
plot("value", na(source[length - 1]) or variance == 0 ? na : 100 * covariance / math.sqrt(variance * timeVariance), "Value")
