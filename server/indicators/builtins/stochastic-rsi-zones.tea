indicator("Stochastic RSI Zones", overlay = false)
length = input.int(14, "RSI and range length", minval = 2, maxval = 500)
smoothing = input.int(3, "Smoothing", minval = 1, maxval = 100)
rsi = ta.rsi(close, length)
k = ta.sma(ta.stoch(rsi, rsi, rsi, length), smoothing)
d = ta.sma(k, smoothing)
pk = plot("k", k, "K", color=#73C1CC, linewidth=2)
pd = plot("d", d, "D", color=#C29ADD)
fill("cross_spread", pk, pd, color=k > d ? color.new(#73C1CC, 75) : color.new(#C29ADD, 75))
u = hline("upper", 80, "Upper threshold", color=#BC91BC, linestyle=hline.style_dashed)
l = hline("lower", 20, "Lower threshold", color=#6CAFA5, linestyle=hline.style_dashed)
fill("middle", u, l, color=color.new(#A4A3BC, 96))
plotshape("lower_cross", barstate.isconfirmed and ta.crossover(k, d) and k < 20, "K crossed above D below 20", style=shape.triangleup, location=location.bottom, color=#73C1CC, text="Low-zone cross", textcolor=#73C1CC, size=size.tiny)
plotshape("upper_cross", barstate.isconfirmed and ta.crossunder(k, d) and k > 80, "K crossed below D above 80", style=shape.triangledown, location=location.top, color=#C29ADD, text="High-zone cross", textcolor=#C29ADD, size=size.tiny)
