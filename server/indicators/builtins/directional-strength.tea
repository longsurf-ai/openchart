indicator("Directional Strength", overlay = false)
length = input.int(14, "Directional length", minval = 2, maxval = 500)
threshold = input.float(25, "Strength threshold", minval = 1, maxval = 100)
[plus, minus, adx] = ta.dmi(length, length)
p = plot("plus", plus, "Positive direction", color=#71C1B1)
m = plot("minus", minus, "Negative direction", color=#C28DAD)
fill("direction", p, m, color=plus > minus ? color.new(#71C1B1, 78) : color.new(#C28DAD, 78))
plot("strength", adx, "ADX strength", color=#D8B675, linewidth=2)
hline("threshold", threshold, "Trend strength threshold", color=#D8B675, linestyle=hline.style_dashed)
plotshape("strong", barstate.isconfirmed and ta.crossover(adx, threshold), "ADX crossed strength threshold", style=shape.diamond, location=location.top, color=#D8B675, text="Trend strengthens", textcolor=#D8B675, size=size.tiny)
