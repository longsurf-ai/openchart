indicator("MACD", overlay = false)
source = input.source(close, "Source")
fast = input.int(12, "Fast length", minval = 1)
slow = input.int(26, "Slow length", minval = 1)
signalLength = input.int(9, "Signal length", minval = 1)
[m, s, h] = ta.macd(source, fast, slow, signalLength)
plot("macd", m, "Macd")
plot("signal", s, "Signal")
plot("histogram", h, "Histogram", color = h >= 0 ? color.teal : color.red, style = "histogram")
