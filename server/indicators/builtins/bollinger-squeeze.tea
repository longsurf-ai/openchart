indicator("Bollinger Squeeze", overlay = true)
length = input.int(20, "Band length", minval = 2, maxval = 500)
multiplier = input.float(2.0, "Standard deviations", minval = 0.1)
rankLength = input.int(100, "Compression lookback", minval = 10, maxval = 500)
[basis, upper, lower] = ta.bb(close, length, multiplier)
width = basis == 0 ? na : (upper - lower) / math.abs(basis)
rank = ta.percentrank(width, rankLength)
squeezed = rank < 20
u = plot("upper", upper, "Upper band", color=#AFA0DA)
l = plot("lower", lower, "Lower band", color=#AFA0DA)
plot("basis", basis, "Average", color=#D4AE6E)
fill("envelope", u, l, color=squeezed ? color.new(#CBA8DE, 74) : color.new(#AFA0DA, 91))
bgcolor("compression", squeezed ? color.new(#CBA8DE, 94) : na)
plotshape("squeeze_start", barstate.isconfirmed and squeezed and not squeezed[1], "Bandwidth entered its lowest fifth", style=shape.circle, location=location.belowbar, color=#CBA8DE, text="Squeeze", textcolor=#CBA8DE, size=size.tiny)
plotshape("up_expansion", barstate.isconfirmed and squeezed[1] and not squeezed and close > upper, "Compression released above band", style=shape.triangleup, location=location.belowbar, color=#55C3A8, text="Expansion up", textcolor=#55C3A8, size=size.tiny)
plotshape("down_expansion", barstate.isconfirmed and squeezed[1] and not squeezed and close < lower, "Compression released below band", style=shape.triangledown, color=#DD897D, text="Expansion down", textcolor=#DD897D, size=size.tiny)
