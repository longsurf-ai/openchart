indicator("ATR Percentile", overlay = false)
length = input.int(14, "ATR length", minval = 1, maxval = 500)
lookback = input.int(100, "Percentile lookback", minval = 10, maxval = 500)
relative = close == 0 ? na : 100 * ta.atr(length) / math.abs(close)
rank = ta.percentrank(relative, lookback)
plot("percentile", rank, "Relative ATR percentile", color=rank >= 80 ? #D7A568 : rank <= 20 ? #78B8C4 : #9EA4C1, style=plot.style_area, linewidth=2)
hline("high", 80, "High volatility percentile", color=#D7A568, linestyle=hline.style_dashed)
hline("low", 20, "Low volatility percentile", color=#78B8C4, linestyle=hline.style_dashed)
plotshape("high_regime", barstate.isconfirmed and ta.crossover(rank, 80), "ATR/price entered upper historical fifth", style=shape.diamond, location=location.top, color=#D7A568, text="High volatility", textcolor=#D7A568, size=size.tiny)
