indicator("MACD Momentum", overlay = false)
source = input.source(close, "Source")
fast = input.int(12, "Fast length", minval = 1, maxval = 500)
slow = input.int(26, "Slow length", minval = 2, maxval = 500)
signalLength = input.int(9, "Signal length", minval = 1, maxval = 500)
[value, signal, histogram] = ta.macd(source, fast, slow, signalLength)
shade = histogram >= 0 ? (histogram > histogram[1] ? #5BCBB4 : #3F827E) : (histogram < histogram[1] ? #DC809D : #905E7D)
plot("histogram", histogram, "Momentum difference", color=shade, style=plot.style_columns)
p = plot("macd", value, "MACD", color=#D6B673, linewidth=2)
s = plot("signal", signal, "Signal", color=#A59AD4)
fill("spread", p, s, color=value >= signal ? color.new(#5BCBB4, 92) : color.new(#DC809D, 92))
hline("zero", 0, "Zero", color=color.new(#A0A0A8, 65))
plotshape("up_cross", barstate.isconfirmed and ta.crossover(value, signal), "MACD crossed above signal", style=shape.triangleup, location=location.bottom, color=#5BCBB4, text="Momentum turns up", textcolor=#5BCBB4, size=size.tiny)
