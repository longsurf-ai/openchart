indicator("Keltner Extension", overlay = true)
length = input.int(20, "Average length", minval = 2, maxval = 500)
atrLength = input.int(10, "ATR length", minval = 1, maxval = 500)
multiplier = input.float(2.0, "ATR multiplier", minval = 0.1)
basis = ta.ema(close, length)
width = multiplier * ta.atr(atrLength)
u = plot("upper", basis + width, "Upper envelope", color=#80BAC8)
l = plot("lower", basis - width, "Lower envelope", color=#80BAC8)
m = plot("middle", basis, "EMA", color=#C8B591)
fill("upper_band", u, m, color=color.new(#80BAC8, 91))
fill("lower_band", m, l, color=color.new(#A498C8, 89))
plotshape("upper_extension", barstate.isconfirmed and ta.crossover(close, basis + width), "Close exceeded upper ATR envelope", style=shape.circle, color=#80BAC8, text="Upper extension", textcolor=#80BAC8, size=size.tiny)
plotshape("lower_extension", barstate.isconfirmed and ta.crossunder(close, basis - width), "Close exceeded lower ATR envelope", style=shape.circle, location=location.belowbar, color=#A498C8, text="Lower extension", textcolor=#A498C8, size=size.tiny)
