indicator("Bollinger Bands %B", overlay = false)
source = input.source(close, "Source")
length = input.int(20, "Length", minval = 1)
multiplier = input.float(2.0, "Multiplier", minval = 0)
[basis, upper, lower] = ta.bb(source, length, multiplier)
plot("value", upper == lower ? na : (source - lower) / (upper - lower), "Value")
