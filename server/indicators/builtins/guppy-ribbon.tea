indicator("Guppy Ribbon", overlay = true)
s = input.source(close, "Source")
fast1 = plot("fast_3", ta.ema(s, 3), "EMA 3", color=#52D3B3)
plot("fast_5", ta.ema(s, 5), "EMA 5", color=#4BC5AE)
plot("fast_8", ta.ema(s, 8), "EMA 8", color=#45B7AA)
plot("fast_10", ta.ema(s, 10), "EMA 10", color=#3EA9A5)
plot("fast_12", ta.ema(s, 12), "EMA 12", color=#389B9F)
fast2 = plot("fast_15", ta.ema(s, 15), "EMA 15", color=#328D9A)
slow1 = plot("slow_30", ta.ema(s, 30), "EMA 30", color=#B8A1DF)
plot("slow_35", ta.ema(s, 35), "EMA 35", color=#AD96D5)
plot("slow_40", ta.ema(s, 40), "EMA 40", color=#A38BCB)
plot("slow_45", ta.ema(s, 45), "EMA 45", color=#9980C1)
plot("slow_50", ta.ema(s, 50), "EMA 50", color=#8F75B7)
slow2 = plot("slow_60", ta.ema(s, 60), "EMA 60", color=#856AAD)
fill("fast_ribbon", fast1, fast2, color=color.new(#46BEAF, 88))
fill("slow_ribbon", slow1, slow2, color=color.new(#A08ACC, 88))
plotshape("ribbon_cross", barstate.isconfirmed and ta.crossover(ta.ema(s, 15), ta.ema(s, 30)), "Fast ribbon overtook slow ribbon", style=shape.triangleup, location=location.belowbar, color=#52D3B3, text="Ribbon expansion", textcolor=#52D3B3, size=size.tiny)
